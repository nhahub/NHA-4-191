# ====================================
# Road-Sense Environment Configuration
# ====================================

# Model
MODEL_PATH=models/checkpoints/best-3classes-exp34332.pt
EXPORT_DIR=models/exports
MODEL_CONFIDENCE=0.25

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Dataset
RAW_DATA_DIR=data/raw/KITTI/training
PROCESSED_DATA_DIR=data/processed/kitti

# Training
TRAINING_CONFIG=configs/training.yaml
DEVICE=cuda:0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/road_sense.log

# Optional: Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=road-sense

# Optional: Prometheus
PROMETHEUS_ENABLED=false
